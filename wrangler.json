{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "novacore-tailorsof-backend",
  "main": "src/index.ts",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": [
    "nodejs_compat",
    "nodejs_compat_populate_process_env"
  ],
  "define": {
    "import.meta.url": "\"file:///worker.js\"",
    "__filename": "\"index.js\"",
    "__dirname": "\"/\""
  },
  "alias": {
    "@prisma/adapter-better-sqlite3": "./src/lib/workers-sqlite-stub.ts",
    "better-sqlite3": "./src/lib/workers-sqlite-stub.ts",
    "./src/lib/prisma-client.ts": "./src/lib/prisma-client.workers.ts",
    "./lib/prisma-client.js": "./src/lib/prisma-client.workers.ts",
    "./lib/prisma-client": "./src/lib/prisma-client.workers.ts",
    "./prisma-client.js": "./src/lib/prisma-client.workers.ts",
    "./prisma-client": "./src/lib/prisma-client.workers.ts",
    "../lib/prisma-client.js": "./src/lib/prisma-client.workers.ts",
    "../lib/prisma-client": "./src/lib/prisma-client.workers.ts"
  },
  "vars": {
    "FRONTEND_URL": "https://novacore-tailorsof-frontend.gora55039.workers.dev",
    "BACKEND_URL": "https://novacore-tailorsof-backend.gora55039.workers.dev"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "novacore-db",
      "database_id": "4ad45dd9-2960-4c78-ad23-93aa98a8e1a4"
    }
  ]
}
