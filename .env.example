# Database
DATABASE_URL="file:./dev.db"

# Auth
AUTH_SECRET="change-me-in-production-use-a-long-random-string"

# Admin fallback credentials (used when no user row exists in DB)
ADMIN_EMAIL="admin@tailorsoft.dev"
ADMIN_PASSWORD="admin123"
ADMIN_NAME="Bluestar Tailors"

# Server
PORT=3001
BACKEND_URL="https://novacore-tailorsof-backend.gora55039.workers.dev"

# CORS – set to your frontend URL in production
FRONTEND_URL="http://localhost:3000"

# Client notifications – Kapso WhatsApp (Meta Cloud API proxy), read from env only.
# On Cloudflare set these via `wrangler secret put`; never commit real values.
KAPSO_API_KEY=
KAPSO_PHONE_NUMBER_ID=
KAPSO_WHATSAPP_ENABLED=true
# Approved WhatsApp template name for business-initiated messages. Its body
# variables {{1}}…{{5}} are filled with (1) greeting, (2) headline, (3) items,
# (4) amount, (5) closing. Leave empty to send plain text (works only inside an
# open 24h session).
KAPSO_WHATSAPP_TEMPLATE=
KAPSO_WHATSAPP_LANGUAGE=en_US
