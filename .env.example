# Database
DATABASE_URL="file:./dev.db"

# Auth
AUTH_SECRET="change-me-in-production-use-a-long-random-string"

# Admin fallback credentials (used when no user row exists in DB)
ADMIN_EMAIL="admin@tailorsoft.dev"
ADMIN_PASSWORD="admin123"
ADMIN_NAME="Bluestar Tailors"

# Server
PORT=3001
BACKEND_URL="https://novacore-tailorsof-backend.gora55039.workers.dev"

# CORS – set to your frontend URL in production
FRONTEND_URL="http://localhost:3000"

# Infobip client notifications (welcome / order / payment / ready for pickup)
# API key from portal.infobip.com → Developers → API keys
INFOBIP_API_KEY="your-infobip-api-key"
# e.g. 3dnmn1.api.infobip.com
INFOBIP_BASE_URL="your-account.api.infobip.com"
# Registered WhatsApp Business sender number in international format (no +).
INFOBIP_WHATSAPP_FROM="919876543210"
INFOBIP_WHATSAPP_ENABLED=true

# Optional SMS fallback. Use an approved sender ID or number from Infobip.
INFOBIP_SMS_FROM="TAILOR"
INFOBIP_SMS_ENABLED=true

# WhatsApp templates are required to start a business conversation outside the
# 24-hour WhatsApp customer-service window. Create the matching Utility
# templates described in README.md, then place their approved names here.
INFOBIP_WHATSAPP_TEMPLATE_LANGUAGE="en"
INFOBIP_WHATSAPP_TEMPLATE_WELCOME="tailor_welcome"
INFOBIP_WHATSAPP_TEMPLATE_ORDER="tailor_order_confirmed"
INFOBIP_WHATSAPP_TEMPLATE_PAYMENT="tailor_payment_received"
INFOBIP_WHATSAPP_TEMPLATE_DELIVERED="tailor_order_ready"
