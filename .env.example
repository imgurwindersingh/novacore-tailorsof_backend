# Database
DATABASE_URL="file:./dev.db"

# Auth
AUTH_SECRET="change-me-in-production-use-a-long-random-string"

# Admin fallback credentials (used when no user row exists in DB)
ADMIN_EMAIL="admin@tailorsoft.dev"
ADMIN_PASSWORD="admin123"
ADMIN_NAME="Bluestar Tailors"

# Server
PORT=3001
BACKEND_URL="https://novacore-tailorsof-backend.gora55039.workers.dev"

# CORS – set to your frontend URL in production
FRONTEND_URL="http://localhost:3000"

# Twilio SMS — client notifications (order placed / ready for pickup)
# Account SID & Auth Token from Console → Account → API keys & tokens
TWILIO_ACCOUNT_SID="ACxxxx..."
TWILIO_AUTH_TOKEN="your-twilio-auth-token"
# Twilio phone number with SMS capability used as the sender (E.164).
TWILIO_PHONE_NUMBER="+1XXXXXXXXXX"
# Trial accounts: only predefined template bodies are allowed. Set true during
# trial; set false/remove after upgrading to send the custom order message.
TWILIO_TRIAL_MODE=true