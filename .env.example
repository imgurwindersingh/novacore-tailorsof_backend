# Database
DATABASE_URL="file:./dev.db"

# Auth
AUTH_SECRET="change-me-in-production-use-a-long-random-string"

# Admin fallback credentials (used when no user row exists in DB)
ADMIN_EMAIL="admin@tailorsoft.dev"
ADMIN_PASSWORD="admin123"
ADMIN_NAME="Bluestar Tailors"

# Server
PORT=3001
BACKEND_URL="https://novacore-tailorsof-backend.gora55039.workers.dev"

# CORS – set to your frontend URL in production
FRONTEND_URL="http://localhost:3000"

# Client notifications – Twilio handles both SMS + WhatsApp, read from env only.
# On Cloudflare set these via `wrangler secret put`; never commit real values.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+14155550123
TWILIO_WHATSAPP_ENABLED=true
# Approved WhatsApp content template (ContentSid). WhatsApp requires an approved
# template for business-initiated messages.
TWILIO_CONTENT_SID=
TWILIO_SMS_TEMPLATE=
# Optional JSON string mapped 1:1 to the template's variables.
TWILIO_CONTENT_VARIABLES=
