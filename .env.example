# Database
DATABASE_URL="file:./dev.db"

# Auth
AUTH_SECRET="change-me-in-production-use-a-long-random-string"

# Admin fallback credentials (used when no user row exists in DB)
ADMIN_EMAIL="admin@tailorsoft.dev"
ADMIN_PASSWORD="admin123"
ADMIN_NAME="Bluestar Tailors"

# Server
PORT=3001
BACKEND_URL="https://novacore-tailorsof-backend.gora55039.workers.dev"

# CORS – set to your frontend URL in production
FRONTEND_URL="http://localhost:3000"

# Client notifications – Vonage Messages API (SMS + WhatsApp), read from env only.
# On Cloudflare set these via `wrangler secret put`; never commit real values.
VONAGE_API_KEY="your-vonage-api-key"
VONAGE_API_SECRET="your-vonage-api-secret"
VONAGE_WHATSAPP_FROM="14157386102"
VONAGE_WHATSAPP_ENABLED=true
# SMS sender (number or alphanumeric; "Vonage APIs" is Vonage's free test sender).
VONAGE_SMS_FROM="Vonage APIs"
# Sandbox only applies to WhatsApp (messages-sandbox.nexmo.com); SMS always uses production.
VONAGE_SANDBOX=true